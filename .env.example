# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Dashboard → Settings → Database → Connection string
# Transaction Pooler (port 6543) 권장 — 서버리스 환경에서 연결 수 제한 방지
SUPABASE_DATABASE_URL=postgresql://postgres.your-project:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ─── 앱 설정 ─────────────────────────────────────────────────────────────────
# 배포 환경의 기본 URL (OAuth redirectTo에 사용됨)
# 개발: http://localhost:3000
# 배포: https://your-domain.com
APP_BASE_URL=http://localhost:3000

# ─── Vite 클라이언트 환경변수 (VITE_ 접두사 필수) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Manus OAuth (레거시 — 전환 기간 동안 유지) ──────────────────────────────
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://oauth.manus.im
JWT_SECRET=your-jwt-secret
OWNER_OPEN_ID=your-owner-open-id

# ─── 기타 서비스 ─────────────────────────────────────────────────────────────
# Toss Payments
TOSS_CLIENT_KEY=your-toss-client-key
TOSS_SECRET_KEY=your-toss-secret-key

# AWS S3 (파일 업로드)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket
